  "serialPresets": {
    "baudRates": [9600, 19200, 38400, 57600, 115200],
    "defaultFraming": "8N1",
    "typical": [
      { "use": "Legacy RTU, long multi-drop run", "baud": 9600,   "framing": "8N1" },
      { "use": "Standard substation RS-485",      "baud": 19200,  "framing": "8N1" },
      { "use": "Short link between IEDs",         "baud": 57600,  "framing": "8N1" },
      { "use": "Local commissioning link",        "baud": 115200, "framing": "8N1" }
    ],
    "termination": { "endOfLineOhm": 120, "biasOhmRange": [450, 650], "biasPoints": 1 }
  },
  "ipPresets": { "dnp3TcpPort": 20000, "dnp3TlsPort": 19999, "iec104Port": 2404, "tcpKeepaliveSeconds": [5, 15] },
