    "note": "Starting points only; agree final values with the control centre.",
    "serial9600": { "class1Seconds": 5, "class2Seconds": 10, "class3Seconds": 30, "integrityMinutes": 60 },
    "serial19200": { "class1Seconds": 3, "class2Seconds": 5, "class3Seconds": 20, "integrityMinutes": 30 },
    "ip": { "class1Seconds": 2, "class2Seconds": 5, "class3Seconds": 10, "integrityMinutes": 15 },
    "unsolicited": { "enabledClasses": [1, 2, 3], "integrityMinutes": 30 }
  },
  "timeouts": { "selectSeconds": [5, 10], "responseSeconds": { "serial": [3, 10], "radio": [5, 15], "ip": [2, 5] } },
